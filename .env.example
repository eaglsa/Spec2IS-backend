# -----------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------
# PostgreSQL connection string (asyncpg driver).
# The app also accepts postgresql:// and will convert it automatically.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/spec2is_db

# -----------------------------------------------------------------------
# LLM provider — choose: gemini | anthropic
# -----------------------------------------------------------------------
LLM_PROVIDER=gemini

# -- Gemini --
GEMINI_API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# -- Anthropic (only needed if LLM_PROVIDER=anthropic) --
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# -----------------------------------------------------------------------
# Embedding model (sentence-transformers)
# -----------------------------------------------------------------------
# Must match the model used when populating standard_embeddings in the DB.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -----------------------------------------------------------------------
# Pipeline tuning knobs
# -----------------------------------------------------------------------
# Minimum combined score for a candidate to appear in recommendations.
CONFIDENCE_THRESHOLD=0.45

# Retrieval weights (must sum to 1.0)
VECTOR_WEIGHT=0.7
KEYWORD_WEIGHT=0.3

# Maximum candidate standards to retrieve / return
MAX_CANDIDATES=20
